    {"id":"place-labels","type":"symbol","source":"shortbread","source-layer":"place_labels","layout":{"text-field":"{name}","text-font":["OpenHD Sans"],"text-size":{"stops":[[5,11],[11,13],[16,15]]}},"paint":{"text-color":"#243649","text-halo-color":"#ffffff","text-halo-width":1.3}}
  ]
