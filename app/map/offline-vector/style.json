    {"id":"buildings","type":"fill","source":"shortbread","source-layer":"buildings","minzoom":14,"paint":{"fill-color":"#dfd5ca","fill-outline-color":"#d2c6ba"}},
    {"id":"minor-roads","type":"line","source":"shortbread","source-layer":"streets","filter":["in","kind","service","residential","living_street","unclassified","tertiary","road","pedestrian"],"layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#ffffff","line-width":{"stops":[[10,0.65],[16,4.2]]}}},
    {"id":"trails","type":"line","source":"shortbread","source-layer":"streets","filter":["in","kind","track","path","footway","cycleway","bridleway","steps"],"paint":{"line-color":"#ac9984","line-width":{"stops":[[12,0.3],[16,1.6]]},"line-dasharray":[2,2]}},
    {"id":"road-casings","type":"line","source":"shortbread","source-layer":"streets","filter":["in","kind","motorway","trunk","primary","secondary"],"layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#cea96d","line-width":{"stops":[[6,0.9],[12,3],[16,8]]}}},
    {"id":"main-roads","type":"line","source":"shortbread","source-layer":"streets","filter":["in","kind","motorway","trunk","primary","secondary"],"layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#ffde9e","line-width":{"stops":[[6,0.6],[12,2],[16,6]]}}},
